<?xml version="1.0" ?>
<sdf version="1.9">
  <world name="robot_world">

    <physics name="1ms" type="ode">
      <max_step_size>0.001</max_step_size>
      <real_time_factor>1</real_time_factor>
    </physics>

    <!-- World Plugins -->
    <plugin filename="gz-sim-physics-system" name="gz::sim::systems::Physics"/>
    <plugin filename="gz-sim-user-commands-system" name="gz::sim::systems::UserCommands"/>
    <plugin filename="gz-sim-scene-broadcaster-system" name="gz::sim::systems::SceneBroadcaster"/>

    <!-- Scene Lighting -->
    <scene>
      <ambient>0.6 0.6 0.6 1</ambient>
      <background>0.85 0.9 0.95 1</background>
      <shadows>true</shadows>
    </scene>

    <light type="directional" name="sun">
      <cast_shadows>true</cast_shadows>
      <pose>5 5 10 0 0 0</pose>
      <diffuse>0.9 0.9 0.9 1</diffuse>
      <direction>-0.5 -0.5 -1</direction>
    </light>

    <!-- Ground Plane -->
    <model name="ground">
      <static>true</static>
      <link name="ground_link">
        <collision name="collision">
          <geometry><plane><normal>0 0 1</normal><size>20 20</size></plane></geometry>
        </collision>
        <visual name="visual">
          <geometry><plane><normal>0 0 1</normal><size>20 20</size></plane></geometry>
          <material>
            <ambient>0.7 0.7 0.7 1</ambient>
            <diffuse>0.7 0.7 0.7 1</diffuse>
          </material>
        </visual>
      </link>
    </model>

    <!-- 2-DOF ROBOT ARM -->
    <model name="test_robot">
      <pose>-1.5 0 0 0 0 0</pose>
      <plugin filename="gz-sim-joint-state-publisher-system" name="gz::sim::systems::JointStatePublisher"/>
      
      <plugin filename="gz-sim-joint-position-controller-system" name="gz::sim::systems::JointPositionController">
        <joint_name>shoulder_joint</joint_name>
        <p_gain>100</p_gain><i_gain>0.1</i_gain><d_gain>10</d_gain>
        <topic>/model/test_robot/joint/shoulder_joint/cmd_pos</topic>
      </plugin>

      <plugin filename="gz-sim-joint-position-controller-system" name="gz::sim::systems::JointPositionController">
        <joint_name>elbow_joint</joint_name>
        <p_gain>50</p_gain><i_gain>0.1</i_gain><d_gain>5</d_gain>
        <topic>/model/test_robot/joint/elbow_joint/cmd_pos</topic>
      </plugin>

      <link name="base_link">
        <pose>0 0 0.1 0 0 0</pose>
        <inertial><mass>10</mass><inertia><ixx>0.1</ixx><iyy>0.1</iyy><izz>0.1</izz></inertia></inertial>
        <visual name="visual">
          <geometry><cylinder><radius>0.2</radius><length>0.2</length></cylinder></geometry>
          <material><ambient>0.3 0.3 0.3 1</ambient><diffuse>0.3 0.3 0.3 1</diffuse></material>
        </visual>
      </link>

      <joint name="world_fixed" type="fixed"><parent>world</parent><child>base_link</child></joint>

      <link name="shoulder_link">
        <pose>0 0 0.4 0 0 0</pose>
        <inertial><mass>2</mass><inertia><ixx>0.02</ixx><iyy>0.02</iyy><izz>0.02</izz></inertia></inertial>
        <visual name="visual">
          <geometry><box><size>0.1 0.1 0.4</size></box></geometry>
          <material><ambient>0.1 0.5 0.8 1</ambient><diffuse>0.1 0.5 0.8 1</diffuse></material>
        </visual>
      </link>

      <joint name="shoulder_joint" type="revolute">
        <parent>base_link</parent><child>shoulder_link</child><pose>0 0 -0.2 0 0 0</pose>
        <axis><xyz>0 1 0</xyz><limit><lower>-1.57</lower><upper>1.57</upper></limit></axis>
      </joint>

      <link name="elbow_link">
        <pose>0 0 0.8 0 0 0</pose>
        <inertial><mass>1</mass><inertia><ixx>0.01</ixx><iyy>0.01</iyy><izz>0.01</izz></inertia></inertial>
        <visual name="visual">
          <geometry><box><size>0.08 0.08 0.4</size></box></geometry>
          <material><ambient>0.8 0.2 0.2 1</ambient><diffuse>0.8 0.2 0.2 1</diffuse></material>
        </visual>
      </link>

      <joint name="elbow_joint" type="revolute">
        <parent>shoulder_link</parent><child>elbow_link</child><pose>0 0 -0.2 0 0 0</pose>
        <axis><xyz>0 1 0</xyz><limit><lower>-1.57</lower><upper>1.57</upper></limit></axis>
      </joint>
    </model>

    <!-- 6-DOF INDUSTRIAL ROBOT ARM -->
    <model name="robot_6dof">
      <pose>1.5 0 0 0 0 0</pose>
      <plugin filename="gz-sim-joint-state-publisher-system" name="gz::sim::systems::JointStatePublisher"/>

      <plugin filename="gz-sim-joint-position-controller-system" name="gz::sim::systems::JointPositionController">
        <joint_name>joint_1</joint_name><p_gain>600</p_gain><i_gain>1.0</i_gain><d_gain>30</d_gain>
        <topic>/model/robot_6dof/joint/joint_1/cmd_pos</topic>
      </plugin>

      <plugin filename="gz-sim-joint-position-controller-system" name="gz::sim::systems::JointPositionController">
        <joint_name>joint_2</joint_name><p_gain>1500</p_gain><i_gain>3.0</i_gain><d_gain>100</d_gain>
        <topic>/model/robot_6dof/joint/joint_2/cmd_pos</topic>
      </plugin>

      <plugin filename="gz-sim-joint-position-controller-system" name="gz::sim::systems::JointPositionController">
        <joint_name>joint_3</joint_name><p_gain>1000</p_gain><i_gain>2.0</i_gain><d_gain>60</d_gain>
        <topic>/model/robot_6dof/joint/joint_3/cmd_pos</topic>
      </plugin>

      <plugin filename="gz-sim-joint-position-controller-system" name="gz::sim::systems::JointPositionController">
        <joint_name>joint_4</joint_name><p_gain>300</p_gain><i_gain>0.5</i_gain><d_gain>20</d_gain>
        <topic>/model/robot_6dof/joint/joint_4/cmd_pos</topic>
      </plugin>

      <plugin filename="gz-sim-joint-position-controller-system" name="gz::sim::systems::JointPositionController">
        <joint_name>joint_5</joint_name><p_gain>200</p_gain><i_gain>0.2</i_gain><d_gain>10</d_gain>
        <topic>/model/robot_6dof/joint/joint_5/cmd_pos</topic>
      </plugin>

      <plugin filename="gz-sim-joint-position-controller-system" name="gz::sim::systems::JointPositionController">
        <joint_name>joint_6</joint_name><p_gain>400</p_gain><i_gain>0.5</i_gain><d_gain>10</d_gain>
        <i_max>10.0</i_max><i_min>-10.0</i_min><cmd_max>50.0</cmd_max><cmd_min>-50.0</cmd_min>
        <topic>/model/robot_6dof/joint/joint_6/cmd_pos</topic>
      </plugin>

      <!-- BASE LINK -->
      <link name="base">
        <pose>0 0 0.1 0 0 0</pose>
        <inertial><mass>15.0</mass><inertia><ixx>0.4</ixx><iyy>0.4</iyy><izz>0.4</izz></inertia></inertial>
        <visual name="pedestal">
          <geometry><cylinder><radius>0.2</radius><length>0.2</length></cylinder></geometry>
          <material><ambient>0.25 0.25 0.28 1</ambient><diffuse>0.25 0.25 0.28 1</diffuse></material>
        </visual>
      </link>

      <joint name="world_fixed_joint" type="fixed"><parent>world</parent><child>base</child></joint>

      <!-- LINK 1 -->
      <link name="link_1">
        <pose>0 0 0.28 0 0 0</pose>
        <inertial><mass>5.0</mass><inertia><ixx>0.08</ixx><iyy>0.08</iyy><izz>0.08</izz></inertia></inertial>
        <visual name="visual">
          <geometry><cylinder><radius>0.16</radius><length>0.16</length></cylinder></geometry>
          <material><ambient>0.2 0.2 0.2 1</ambient><diffuse>0.2 0.2 0.2 1</diffuse></material>
        </visual>
      </link>

      <joint name="joint_1" type="revolute">
        <parent>base</parent><child>link_1</child><pose>0 0 -0.08 0 0 0</pose>
        <axis><xyz>0 0 1</xyz><limit><lower>-3.14</lower><upper>3.14</upper></limit><dynamics><damping>15</damping><friction>3</friction></dynamics></axis>
      </joint>

      <!-- LINK 2 -->
      <link name="link_2">
        <pose>0 0.16 0.55 0 0 0</pose>
        <inertial><mass>4.5</mass><inertia><ixx>0.1</ixx><iyy>0.1</iyy><izz>0.03</izz></inertia></inertial>
        <visual name="j2_hub">
          <pose>0 -0.08 -0.2 1.5708 0 0</pose>
          <geometry><cylinder><radius>0.11</radius><length>0.18</length></cylinder></geometry>
          <material><ambient>0.2 0.2 0.2 1</ambient><diffuse>0.2 0.2 0.2 1</diffuse></material>
        </visual>
        <visual name="upper_arm_body">
          <geometry><box><size>0.14 0.12 0.45</size></box></geometry>
          <material><ambient>0.95 0.6 0.05 1</ambient><diffuse>0.95 0.6 0.05 1</diffuse></material>
        </visual>
      </link>

      <joint name="joint_2" type="revolute">
        <parent>link_1</parent><child>link_2</child><pose>0 -0.08 -0.2 0 0 0</pose>
        <axis><xyz>0 1 0</xyz><limit><lower>-1.57</lower><upper>1.57</upper></limit><dynamics><damping>25</damping><friction>6</friction></dynamics></axis>
      </joint>

      <!-- LINK 3 -->
      <link name="link_3">
        <pose>0 0.16 0.95 0 0 0</pose>
        <inertial><mass>2.8</mass><inertia><ixx>0.05</ixx><iyy>0.05</iyy><izz>0.01</izz></inertia></inertial>
        <visual name="j3_hub">
          <pose>0 0 -0.18 1.5708 0 0</pose>
          <geometry><cylinder><radius>0.09</radius><length>0.16</length></cylinder></geometry>
          <material><ambient>0.2 0.2 0.2 1</ambient><diffuse>0.2 0.2 0.2 1</diffuse></material>
        </visual>
        <visual name="forearm_body">
          <geometry><box><size>0.11 0.1 0.35</size></box></geometry>
          <material><ambient>0.95 0.6 0.05 1</ambient><diffuse>0.95 0.6 0.05 1</diffuse></material>
        </visual>
      </link>

      <joint name="joint_3" type="revolute">
        <parent>link_2</parent><child>link_3</child><pose>0 0 -0.18 0 0 0</pose>
        <axis><xyz>0 1 0</xyz><limit><lower>-2.0</lower><upper>2.0</upper></limit><dynamics><damping>18</damping><friction>4</friction></dynamics></axis>
      </joint>

      <!-- LINK 4 -->
      <link name="link_4">
        <pose>0 0.28 1.15 0 0 0</pose>
        <inertial><mass>1.2</mass><inertia><ixx>0.01</ixx><iyy>0.01</iyy><izz>0.005</izz></inertia></inertial>
        <visual name="wrist_pitch_body">
          <pose>0 0 0 1.5708 0 0</pose>
          <geometry><cylinder><radius>0.065</radius><length>0.14</length></cylinder></geometry>
          <material><ambient>0.25 0.25 0.28 1</ambient><diffuse>0.25 0.25 0.28 1</diffuse></material>
        </visual>
      </link>

      <joint name="joint_4" type="revolute">
        <parent>link_3</parent><child>link_4</child><pose>0 -0.12 -0.02 0 0 0</pose>
        <axis><xyz>0 1 0</xyz><limit><lower>-1.57</lower><upper>1.57</upper></limit><dynamics><damping>6</damping><friction>1.2</friction></dynamics></axis>
      </joint>

      <!-- LINK 5 -->
      <link name="link_5">
        <pose>0 0.28 1.25 0 0 0</pose>
        <inertial><mass>0.6</mass><inertia><ixx>0.003</ixx><iyy>0.003</iyy><izz>0.002</izz></inertia></inertial>
        <visual name="wrist_roll_body">
          <geometry><box><size>0.09 0.09 0.1</size></box></geometry>
          <material><ambient>0.2 0.2 0.2 1</ambient><diffuse>0.2 0.2 0.2 1</diffuse></material>
        </visual>
      </link>

      <joint name="joint_5" type="revolute">
        <parent>link_4</parent><child>link_5</child><pose>0 0 -0.05 0 0 0</pose>
        <axis><xyz>1 0 0</xyz><limit><lower>-3.14</lower><upper>3.14</upper></limit><dynamics><damping>4</damping><friction>0.8</friction></dynamics></axis>
      </joint>

      <!-- LINK 6 -->
      <link name="link_6">
        <pose>0 0.28 1.33 0 0 0</pose>
        <inertial><mass>0.5</mass><inertia><ixx>0.01</ixx><iyy>0.01</iyy><izz>0.01</izz></inertia></inertial>
        <visual name="tool_flange">
          <geometry><cylinder><radius>0.055</radius><length>0.04</length></cylinder></geometry>
          <material><ambient>0.1 0.7 0.3 1</ambient><diffuse>0.1 0.7 0.3 1</diffuse></material>
        </visual>
      </link>

      <joint name="joint_6" type="revolute">
        <parent>link_5</parent><child>link_6</child><pose>0 0 0 0 0 0</pose>
        <axis><xyz>0 0 1</xyz><limit><lower>-3.14</lower><upper>3.14</upper></limit><dynamics><damping>0.1</damping><friction>0.01</friction></dynamics></axis>
      </joint>
    </model>

  </world>
</sdf>