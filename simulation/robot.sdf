<?xml version="1.0" ?>
<sdf version="1.9">

  <world name="robot_world">

    <physics name="1ms" type="ode">
      <max_step_size>0.001</max_step_size>
      <real_time_factor>1</real_time_factor>
    </physics>

    <gui fullscreen="0">
      <camera name="user_camera">
        <!-- x y z roll pitch yaw (Positioned to the right side of the arm) -->
        <pose>0 -5 1.5 0 0 1.5708</pose>
        <view_controller>orbit</view_controller>
      </camera>
    </gui>

    <!-- World Plugins -->
    <plugin filename="gz-sim-physics-system" name="gz::sim::systems::Physics"/>
    <plugin filename="gz-sim-user-commands-system" name="gz::sim::systems::UserCommands"/>
    <plugin filename="gz-sim-scene-broadcaster-system" name="gz::sim::systems::SceneBroadcaster"/>

    <!-- High-Visibility Scene Lighting -->
    <scene>
      <ambient>0.7 0.7 0.7 1</ambient>
      <background>0.8 0.85 0.9 1</background>
      <shadows>false</shadows>
    </scene>

    <light type="directional" name="sun">
      <cast_shadows>false</cast_shadows>
      <pose>5 5 10 0 0 0</pose>
      <diffuse>0.9 0.9 0.9 1</diffuse>
      <specular>0.1 0.1 0.1 1</specular>
      <direction>-0.5 -0.5 -1</direction>
    </light>

    <!-- Ground Plane -->
    <model name="ground">
      <static>true</static>
      <link name="ground_link">
        <collision name="collision">
          <geometry>
            <plane>
              <normal>0 0 1</normal>
              <size>20 20</size>
            </plane>
          </geometry>
        </collision>
        <visual name="visual">
          <geometry>
            <plane>
              <normal>0 0 1</normal>
              <size>20 20</size>
            </plane>
          </geometry>
          <material>
            <ambient>0.8 0.8 0.8 1</ambient>
            <diffuse>0.8 0.8 0.8 1</diffuse>
          </material>
        </visual>
      </link>
    </model>

    <!-- 2-DOF Robot Model -->
    <model name="test_robot">

      <!-- Joint Telemetry & Position Controller Plugins -->
      <plugin filename="gz-sim-joint-state-publisher-system" name="gz::sim::systems::JointStatePublisher"/>

      <plugin filename="gz-sim-joint-position-controller-system" name="gz::sim::systems::JointPositionController">
        <joint_name>shoulder_joint</joint_name>
        <p_gain>100</p_gain>
        <i_gain>0.1</i_gain>
        <d_gain>10</d_gain>
        <topic>/model/test_robot/joint/shoulder_joint/cmd_pos</topic>
      </plugin>

      <plugin filename="gz-sim-joint-position-controller-system" name="gz::sim::systems::JointPositionController">
        <joint_name>elbow_joint</joint_name>
        <p_gain>100</p_gain>
        <i_gain>0.1</i_gain>
        <d_gain>10</d_gain>
        <topic>/model/test_robot/joint/elbow_joint/cmd_pos</topic>
      </plugin>

      <!-- BASE LINK (Dark Slate) -->
      <link name="base">
        <pose>0 0 0.5 0 0 0</pose>
        <inertial>
          <mass>5</mass>
          <inertia>
            <ixx>0.1</ixx><iyy>0.1</iyy><izz>0.1</izz>
          </inertia>
        </inertial>
        <visual name="visual">
          <geometry>
            <box><size>1 1 1</size></box>
          </geometry>
          <material>
            <ambient>0.17 0.24 0.31 1</ambient>
            <diffuse>0.17 0.24 0.31 1</diffuse>
          </material>
        </visual>
        <collision name="collision">
          <geometry>
            <box><size>1 1 1</size></box>
          </geometry>
        </collision>
      </link>

      <!-- FIX: Fixed Joint Anchoring Base to World -->
      <joint name="world_fixed_joint" type="fixed">
        <parent>world</parent>
        <child>base</child>
      </joint>

      <!-- LINK 1: SHOULDER (Orange) -->
      <link name="shoulder_link">
        <pose>0 0 1.5 0 0 0</pose>
        <inertial>
          <mass>2</mass>
          <inertia>
            <ixx>0.05</ixx><iyy>0.05</iyy><izz>0.05</izz>
          </inertia>
        </inertial>
        <visual name="visual">
          <geometry>
            <box><size>0.4 0.4 1.5</size></box>
          </geometry>
          <material>
            <ambient>0.9 0.49 0.13 1</ambient>
            <diffuse>0.9 0.49 0.13 1</diffuse>
          </material>
        </visual>
        <!-- Red Joint Marker at Axis -->
        <visual name="joint_marker">
          <pose>0 0 -0.5 1.5708 0 0</pose>
          <geometry>
            <cylinder><radius>0.25</radius><length>0.5</length></cylinder>
          </geometry>
          <material>
            <ambient>0.9 0.1 0.1 1</ambient>
            <diffuse>0.9 0.1 0.1 1</diffuse>
          </material>
        </visual>
        <collision name="collision">
          <geometry>
            <box><size>0.4 0.4 1.5</size></box>
          </geometry>
        </collision>
      </link>

      <!-- JOINT 1: SHOULDER (DOF 1) -->
      <joint name="shoulder_joint" type="revolute">
        <parent>base</parent>
        <child>shoulder_link</child>
        <pose>0 0 -0.5 0 0 0</pose>
        <axis>
          <xyz>0 1 0</xyz>
          <limit>
            <lower>-1.5708</lower>
            <upper>1.5708</upper>
          </limit>
        </axis>
      </joint>

      <!-- LINK 2: ELBOW (Blue) -->
      <link name="elbow_link">
        <pose>0 0 2.75 0 0 0</pose>
        <inertial>
          <mass>1</mass>
          <inertia>
            <ixx>0.03</ixx><iyy>0.03</iyy><izz>0.03</izz>
          </inertia>
        </inertial>
        <visual name="visual">
          <geometry>
            <box><size>0.3 0.3 1</size></box>
          </geometry>
          <material>
            <ambient>0.2 0.6 1.0 1</ambient>
            <diffuse>0.2 0.6 1.0 1</diffuse>
          </material>
        </visual>
        <!-- Yellow Joint Marker at Axis -->
        <visual name="joint_marker">
          <pose>0 0 -0.5 1.5708 0 0</pose>
          <geometry>
            <cylinder><radius>0.2</radius><length>0.4</length></cylinder>
          </geometry>
          <material>
            <ambient>0.9 0.8 0.1 1</ambient>
            <diffuse>0.9 0.8 0.1 1</diffuse>
          </material>
        </visual>
        <collision name="collision">
          <geometry>
            <box><size>0.3 0.3 1</size></box>
          </geometry>
        </collision>
      </link>

      <!-- JOINT 2: ELBOW (DOF 2) -->
      <joint name="elbow_joint" type="revolute">
        <parent>shoulder_link</parent>
        <child>elbow_link</child>
        <pose>0 0 -0.5 0 0 0</pose>
        <axis>
          <xyz>0 1 0</xyz>
          <limit>
            <lower>-1.5708</lower>
            <upper>1.5708</upper>
          </limit>
        </axis>
      </joint>

    </model>

  </world>
</sdf>