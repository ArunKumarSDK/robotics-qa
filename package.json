{
  "name": "robotics-qa",
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "start": "tsx src/index.ts",
    "test:bdd": "NODE_OPTIONS='--import tsx' cucumber-js --import features/steps/robot_steps.ts features/robot_arm.feature",
    "test:bdd:6dof": "NODE_OPTIONS='--import tsx' cucumber-js --import features/steps/robot_steps.ts features/robot_6dof.feature",
    "test:bdd:all": "NODE_OPTIONS='--import tsx' cucumber-js --import features/steps/robot_steps.ts features/*.feature",
    "test:all": "./scripts/run_all_tests.sh"
  },
  "devDependencies": {
    "@cucumber/cucumber": "^10.0.0",
    "@types/node": "^26.6.3",
    "expect": "^29.0.0",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2"
  }
}